@prefix sh:             <http://www.w3.org/ns/shacl#> .
@prefix aif-ops:        <https://visum.ai/ns/aif-ops#> .
@prefix aif-ops-shapes: <https://visum.ai/ns/aif-ops-shapes#> .
@prefix brick:          <https://brickschema.org/schema/Brick#> .
@prefix rdfs:           <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:            <http://www.w3.org/2001/XMLSchema#> .

# -----------------------------------------------------------------------
# Section 5.1: Coolant Distribution Unit shape
# -----------------------------------------------------------------------

aif-ops-shapes:CDU_Shape a sh:NodeShape ;
    sh:targetClass aif-ops:Coolant_Distribution_Unit ;
    sh:property [
        sh:path aif-ops:hasFailureMode ;
        sh:minCount 1 ;
        sh:class aif-ops:FailureMode ;
        sh:message "A CDU must have at least one documented failure mode." ;
    ] ;
    sh:property [
        sh:path aif-ops:isIsolatedBy ;
        sh:minCount 1 ;
        sh:class aif-ops:IsolationPoint ;
        sh:message "A CDU must have at least one isolation point." ;
    ] ;
    sh:property [
        sh:path aif-ops:hasMaintenanceTask ;
        sh:minCount 1 ;
        sh:class aif-ops:MaintenanceTask ;
        sh:message "A CDU must have at least one scheduled maintenance task." ;
    ] ;
    sh:property [
        sh:path brick:hasPoint ;
        sh:minCount 1 ;
        sh:message "A CDU must have at least one associated point." ;
    ] ;
    sh:property [
        sh:path brick:hasPoint ;
        sh:qualifiedValueShape [ sh:class brick:Leak_Detection_Sensor ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A CDU must have at least one leak-detection sensor." ;
    ] ;
    sh:property [
        sh:path brick:feeds ;
        sh:minCount 1 ;
        sh:message "A CDU must feed at least one downstream component." ;
    ] ;
    sh:property [
        sh:path brick:feeds ;
        sh:qualifiedValueShape [ sh:or (
            [ sh:class aif-ops:Cold_Plate ]
            [ sh:class aif-ops:Rear_Door_Heat_Exchanger ]
            [ sh:class aif-ops:Immersion_Cooling_Tank ]
            [ sh:class aif-ops:Liquid_Cooling_Manifold ]
        ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A CDU must feed at least one cold plate, rear-door heat exchanger, immersion cooling tank, or liquid cooling manifold." ;
    ] .

# -----------------------------------------------------------------------
# Section 5.2: Operational entity class shapes (all 12 classes)
# -----------------------------------------------------------------------

# Procedure: must reference at least one equipment instance and at least one sequence
aif-ops-shapes:Procedure_Shape a sh:NodeShape ;
    sh:targetClass aif-ops:Procedure ;
    sh:property [
        sh:path aif-ops:executesOn ;
        sh:minCount 1 ;
        sh:class brick:Equipment ;
    ] ;
    sh:property [
        sh:path aif-ops:hasSequence ;
        sh:minCount 1 ;
        sh:class aif-ops:Sequence ;
    ] ;
    sh:property [
        sh:path aif-ops:approvedBy ;
        sh:minCount 0 ;
        sh:class aif-ops:Actor ;
        sh:message "approvedBy must reference an Actor." ;
    ] .

# Sequence: must reference at least one ordered Action
aif-ops-shapes:Sequence_Shape a sh:NodeShape ;
    sh:targetClass aif-ops:Sequence ;
    sh:property [
        sh:path aif-ops:hasAction ;
        sh:minCount 1 ;
        sh:class aif-ops:Action ;
    ] .

# Action: must declare its actor and its position in the sequence
aif-ops-shapes:Action_Shape a sh:NodeShape ;
    sh:targetClass aif-ops:Action ;
    sh:property [
        sh:path aif-ops:performedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class aif-ops:Actor ;
    ] ;
    sh:property [
        sh:path aif-ops:stepOrder ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:message "Every action must declare its 1-indexed integer position in the sequence." ;
    ] ;
    sh:property [
        sh:path aif-ops:verb ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "Start" "Stop" "Open" "Close" "Set" "Reset" "Wait" "Compare" "Jump" "Verify" ) ;
        sh:message "verb must be one of: Start, Stop, Open, Close, Set, Reset, Wait, Compare, Jump, Verify." ;
    ] ;
    sh:property [
        sh:path aif-ops:on_failure ;
        sh:maxCount 1 ;
        sh:class aif-ops:Action ;
        sh:message "on_failure must point to exactly one Action node." ;
    ] .
# NOTE: uniqueness and contiguity of stepOrder values across all actions in a given
# Sequence cannot be expressed in SHACL Core. Duplicate or gapped orderings will not
# produce a validation failure. Full ordering integrity requires SHACL-SPARQL (deferred).

# OperatingMode: if a transition exists, it must point at another OperatingMode;
# entry/exit conditions, if present, must reference Brick sensor points
# (sh:minCount 0 on all because terminal modes have no outgoing transition and
# not every mode has sensor-point conditions documented in the source)
aif-ops-shapes:OperatingMode_Shape a sh:NodeShape ;
    sh:targetClass aif-ops:OperatingMode ;
    sh:property [
        sh:path aif-ops:transitionsTo ;
        sh:minCount 0 ;
        sh:class aif-ops:OperatingMode ;
    ] ;
    sh:property [
        sh:path aif-ops:entry_conditions ;
        sh:minCount 0 ;
        sh:class brick:Point ;
    ] ;
    sh:property [
        sh:path aif-ops:exit_conditions ;
        sh:minCount 0 ;
        sh:class brick:Point ;
    ] .

# Event: if it triggers anything, that target must be a Procedure
# (sh:minCount 0 because log-only events do not trigger a full Procedure)
aif-ops-shapes:Event_Shape a sh:NodeShape ;
    sh:targetClass aif-ops:Event ;
    sh:property [
        sh:path aif-ops:triggers ;
        sh:minCount 0 ;
        sh:class aif-ops:Procedure ;
    ] .

# Interlock: must gate at least one Action; hard_or_soft, if present, must be 'hard' or 'soft'
aif-ops-shapes:Interlock_Shape a sh:NodeShape ;
    sh:targetClass aif-ops:Interlock ;
    sh:property [
        sh:path aif-ops:gatesAction ;
        sh:minCount 1 ;
        sh:class aif-ops:Action ;
    ] ;
    sh:property [
        sh:path aif-ops:hard_or_soft ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "hard" "soft" ) ;
        sh:message "hard_or_soft must be 'hard' or 'soft'." ;
    ] .

# FailureMode: must reference detection plus mitigation
aif-ops-shapes:FailureMode_Shape a sh:NodeShape ;
    sh:targetClass aif-ops:FailureMode ;
    sh:property [
        sh:path aif-ops:hasDetectionSignature ;
        sh:minCount 1 ;
        sh:class brick:Point ;
    ] ;
    sh:property [
        sh:path aif-ops:mitigatedBy ;
        sh:minCount 1 ;
        sh:class aif-ops:Procedure ;
    ] .

# MaintenanceTask (base): must be typed as exactly one concrete subclass.
# Direct instances of the abstract base class escape subclass validation;
# this shape enforces that every MaintenanceTask is either Scheduled or OnCondition.
aif-ops-shapes:MaintenanceTask_Shape a sh:NodeShape ;
    sh:targetClass aif-ops:MaintenanceTask ;
    sh:or (
        [ sh:class aif-ops:ScheduledMaintenanceTask ]
        [ sh:class aif-ops:OnConditionMaintenanceTask ]
    ) ;
    sh:message "A MaintenanceTask must be typed as ScheduledMaintenanceTask or OnConditionMaintenanceTask — the base class is abstract." .

# ScheduledMaintenanceTask: must declare a fixed ISO 8601 recurrence interval
aif-ops-shapes:ScheduledMaintenanceTask_Shape a sh:NodeShape ;
    sh:targetClass aif-ops:ScheduledMaintenanceTask ;
    sh:property [
        sh:path aif-ops:recursEvery ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:duration ;
    ] .

# OnConditionMaintenanceTask: must describe the condition that triggers service
aif-ops-shapes:OnConditionMaintenanceTask_Shape a sh:NodeShape ;
    sh:targetClass aif-ops:OnConditionMaintenanceTask ;
    sh:property [
        sh:path aif-ops:hasTriggerCondition ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:message "An on-condition maintenance task must describe its trigger condition." ;
    ] .

# CommissioningStep: must declare pass and fail criteria as literals
aif-ops-shapes:CommissioningStep_Shape a sh:NodeShape ;
    sh:targetClass aif-ops:CommissioningStep ;
    sh:property [
        sh:path aif-ops:hasPassCriteria ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path aif-ops:hasFailCriteria ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
    ] .

# IsolationPoint: must have an isolation procedure
aif-ops-shapes:IsolationPoint_Shape a sh:NodeShape ;
    sh:targetClass aif-ops:IsolationPoint ;
    sh:property [
        sh:path aif-ops:hasIsolationProcedure ;
        sh:minCount 1 ;
        sh:class aif-ops:Procedure ;
    ] .

# LockoutTagoutStep: must reference its parent isolation procedure
aif-ops-shapes:LockoutTagoutStep_Shape a sh:NodeShape ;
    sh:targetClass aif-ops:LockoutTagoutStep ;
    sh:property [
        sh:path aif-ops:partOfProcedure ;
        sh:minCount 1 ;
        sh:class aif-ops:Procedure ;
    ] ;
    sh:property [
        sh:path aif-ops:authorizedEmployee ;
        sh:minCount 0 ;
        sh:class aif-ops:Actor ;
        sh:message "authorizedEmployee must reference an Actor." ;
    ] .

# Actor: must have a label (the four named individuals in the ontology satisfy this;
# site-defined role extensions must also carry a label)
aif-ops-shapes:Actor_Shape a sh:NodeShape ;
    sh:targetClass aif-ops:Actor ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:message "Every Actor must have a label." ;
    ] .

# Cross-cutting: wherever sourceKind is asserted, it must use the closed vocabulary
aif-ops-shapes:SourceKind_Shape a sh:NodeShape ;
    sh:targetSubjectsOf aif-ops:sourceKind ;
    sh:property [
        sh:path aif-ops:sourceKind ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "normative" "vendor_default" "site_setting" "sme_confirmed" ) ;
        sh:message "sourceKind must be one of: normative, vendor_default, site_setting, sme_confirmed." ;
    ] .
